{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VHO",
  "version": "0.1.0",
  "identifier": "com.vho.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VHO - Video H Oynatıcısı",
        "width": 1100,
        "height": 680,
        "minWidth": 640,
        "minHeight": 420,
        "decorations": false,
        "transparent": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' asset: http://asset.localhost;style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' blob: data: asset: http://asset.localhost https: http:; media-src 'self' blob: data: asset: http://asset.localhost https: http:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {"ext": ["mp4", "m4v", "mkv", "avi", "mov", "wmv", "webm", "flv", "ts", "m2ts", "mts", "3gp", "3g2", "mpg", "mpeg", "vob", "ogv", "asf", "divx", "f4v"], "name": "VHO Video", "description": "Video dosyası", "role": "Viewer"},
      {"ext": ["mp3", "flac", "wav", "m4a", "aac", "ogg", "oga", "opus", "wma"], "name": "VHO Audio", "description": "Ses dosyası", "role": "Viewer"},
      {"ext": ["jpg", "jpeg", "jpe", "jfif", "png", "webp", "gif", "bmp", "avif", "heic", "heif", "tif", "tiff", "dng", "cr2", "cr3", "nef", "arw", "orf", "rw2", "raf"], "name": "VHO Image", "description": "Görsel dosyası", "role": "Viewer"},
      {"ext": ["srt", "vtt", "ass", "ssa"], "name": "VHO Subtitle", "description": "Altyazı dosyası", "role": "Viewer"}
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
