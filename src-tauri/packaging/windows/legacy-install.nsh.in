; NSIS installer hook (Tauri bundle.windows.nsis.installerHooks), generated by
; scripts/package-windows.ps1 with @LEGACY@ = the previous product name (rename VHO -> HS Studio,
; docs/release/rename-hs-studio.md). Compiles to nothing while the product name is unchanged.
;
; Before installing, a per-user install of the previous product name is removed with its own
; uninstaller (silent: user data is kept, its file associations and shortcuts are removed), so the
; renamed app does not end up installed twice. The app data itself is copied to the new
; identifier by the app on first start (src-tauri/src/identity.rs).
!macro NSIS_HOOK_PREINSTALL
  !if "${PRODUCTNAME}" != "@LEGACY@"
    Push $R5
    Push $R6
    ReadRegStr $R5 HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\@LEGACY@" "InstallLocation"
    ${If} $R5 != ""
      StrCpy $R6 $R5 1
      ${If} $R6 == '"'
        StrCpy $R5 $R5 "" 1
        StrCpy $R5 $R5 -1
      ${EndIf}
      ${If} ${FileExists} "$R5\uninstall.exe"
        DetailPrint "Removing the previous @LEGACY@ installation (user data is kept): $R5"
        ExecWait '"$R5\uninstall.exe" /S _?=$R5' $R6
        Delete "$R5\uninstall.exe"
        RMDir "$R5"
      ${EndIf}
    ${EndIf}
    Pop $R6
    Pop $R5
  !endif
!macroend
