; NSIS installer hook (Tauri bundle.windows.nsis.installerHooks), generated by
; scripts/package-windows.ps1 with @LEGACY@ = the previous product name (rename VHO -> HS Studio,
; docs/release/rename-hs-studio.md). Compiles to nothing while the product name is unchanged.
;
; Before installing, a per-user install of the previous product name is removed with its own
; uninstaller (silent: user data is kept, its file associations and shortcuts are removed), so the
; renamed app does not end up installed twice. The app data itself is copied to the new
; identifier by the app on first start (src-tauri/src/identity.rs).
; One trace line goes to %TEMP%\legacy-install-hook.log (support / the rename rehearsal).
!macro NSIS_HOOK_PREINSTALL
  !if "${PRODUCTNAME}" != "@LEGACY@"
    Push $R5
    Push $R6
    Push $R7
    ReadRegStr $R5 HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\@LEGACY@" "InstallLocation"
    ${If} $R5 != ""
      StrCpy $R6 $R5 1
      ${If} $R6 == '"'
        StrCpy $R5 $R5 "" 1
        StrCpy $R5 $R5 -1
      ${EndIf}
      ${If} ${FileExists} "$R5\uninstall.exe"
        DetailPrint "Removing the previous @LEGACY@ installation (user data is kept): $R5"
        ; The old uninstaller aborts (exit code 2) while the old app or its WebView2 processes are
        ; still running: retry a few times, then ask the user to close it. Never continue with
        ; both products installed: cancel (or a silent install) aborts this installation.
        StrCpy $R7 0
        ${Do}
          ExecWait '"$R5\uninstall.exe" /S _?=$R5' $R6
          IntOp $R7 $R7 + 1
          ${If} $R6 == 0
            ${Break}
          ${EndIf}
          ${If} $R7 < 4
            Sleep 3000
          ${Else}
            MessageBox MB_RETRYCANCEL|MB_ICONEXCLAMATION "@LEGACY@ hâlâ açık görünüyor. Lütfen @LEGACY@ uygulamasını kapatıp Yeniden Dene'ye tıklayın.$\r$\n$\r$\n@LEGACY@ still seems to be running. Please close it and click Retry." /SD IDCANCEL IDRETRY legacy_retry
            ${Break}
            legacy_retry:
          ${EndIf}
        ${Loop}
        Push $R7
        FileOpen $R7 "$TEMP\legacy-install-hook.log" a
        FileSeek $R7 0 END
        FileWrite $R7 "@LEGACY@ at $R5: uninstaller exit code $R6$\r$\n"
        FileClose $R7
        Pop $R7
        ${If} $R6 == 0
          Delete "$R5\uninstall.exe"
          RMDir "$R5"
        ${Else}
          Pop $R7
          Pop $R6
          Pop $R5
          Abort "@LEGACY@ kaldırılamadı; kurulum iptal edildi. / Could not remove @LEGACY@; installation cancelled."
        ${EndIf}
      ${Else}
        FileOpen $R7 "$TEMP\legacy-install-hook.log" a
        FileSeek $R7 0 END
        FileWrite $R7 "@LEGACY@ registered at $R5 but no uninstall.exe there$\r$\n"
        FileClose $R7
      ${EndIf}
    ${EndIf}
    Pop $R7
    Pop $R6
    Pop $R5
  !endif
!macroend
