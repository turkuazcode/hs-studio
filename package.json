{
  "name": "vho",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite src --port 3000",
    "tauri": "tauri",
    "build:release": "tauri build --no-bundle",
    "test": "node scripts/run-tests.mjs unit",
    "test:rust": "cargo test --release --lib --manifest-path src-tauri/Cargo.toml",
    "e2e": "node scripts/run-tests.mjs e2e",
    "test:ai": "node scripts/run-tests.mjs ai",
    "test:quality": "node scripts/run-tests.mjs quality",
    "bench:media": "node scripts/bench-media.mjs",
    "quality:ab": "node scripts/quality-ab.mjs",
    "fixtures": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/fixtures/make-fixtures.ps1",
    "fixtures:engine": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/fixtures/make-engine-fixtures.ps1",
    "stage:mpv": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stage-mpv.ps1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "vite": "^8.3.5"
  }
}
