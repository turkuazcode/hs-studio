{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mpv-spike",
  "version": "0.0.1",
  "identifier": "com.vho.mpvspike",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VHO mpv spike",
        "width": 1100,
        "height": 680,
        "minWidth": 480,
        "minHeight": 320,
        "decorations": false,
        "transparent": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
