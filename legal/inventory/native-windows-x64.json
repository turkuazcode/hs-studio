{
  "$comment": "Native binaries VHO ships on Windows x64 next to VHO.exe (staged by scripts/stage-mpv.ps1). Edited by hand when the libmpv build changes; hashes are refreshed with: node legal/generate-sbom.mjs --native-dist <dist> --native-bin <prefix/bin> --update-native. See legal/INVENTORY.md.",
  "platform": "windows-x86_64",
  "delivery": "Separate files next to VHO.exe. libmpv-2.dll is loaded at runtime (libloading) and may be replaced by the user; ffmpeg.exe/ffprobe.exe run as separate processes. Nothing here is linked into VHO.exe.",
  "build": {
    "recipe": "third_party/mpv/build-windows.sh",
    "doc": "third_party/mpv/build-windows.md",
    "evidence": "third_party/mpv/evidence/windows/",
    "toolchain": "MSYS2 UCRT64, mingw-w64-ucrt-x86_64-gcc 16.2.0-6",
    "builtOn": "2026-10-23",
    "reproducible": false,
    "hashesNote": "sha256/bytes are those of the CI build (native-windows.yml) of 2026-10-28 that the release workflow ships and the E2E tests ran against. The build is not bit-for-bit reproducible: a release build must refresh them (--update-native) and ship exactly the hashed files."
  },
  "sources": {
    "ffmpeg": {
      "tag": "n8.1.3",
      "commit": "1041abdc962f4cc4f394aa8de9dc5236c0c3b9e7",
