      "repository": "https://git.ffmpeg.org/ffmpeg.git",
      "mirror": "https://github.com/FFmpeg/FFmpeg",
      "configure": [
        "--target-os=mingw32",
        "--arch=x86_64",
        "--enable-shared",
        "--disable-static",
        "--disable-doc",
        "--disable-debug",
        "--disable-ffplay",
        "--enable-libdav1d",
