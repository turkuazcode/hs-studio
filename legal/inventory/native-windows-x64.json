    "msys2": {
      "packageList": "third_party/mpv/evidence/windows/msys2-packages.txt",
      "sourcePackages": "https://repo.msys2.org/mingw/sources/<pkgbase>-<version>.src.tar.zst (PKGBUILD + upstream tarball + MSYS2 patches)",
      "recipes": "https://github.com/msys2/MINGW-packages/tree/<commit>/<pkgbase>",
      "note": "URL pattern and pkgbase names not verified online in R01. Before a release, download the source packages of every LGPL DLL (preferably of all DLLs) at exactly these versions and archive them with the release (legal/INVENTORY.md, 'Corresponding source')."
